# GitBanners: environment variables of the account layer
# (sessions, GitHub sign-in, Pro, saved banners, rate limiting).
#
# Copy to .env.development.local for local work. On Vercel set them per
# environment, secrets as "Sensitive", and use DIFFERENT secrets for
# production and preview.
#
# Nothing here is needed to render public banners. Without the first three
# groups the app still boots; sign-in then answers
# "Accounts are not configured on this deployment".
#
# Optional variables are commented out. An empty value counts as unset.

# --- Sessions ---------------------------------------------------------------

# Signs the session and sign-in cookies (HS256). Base64 of at least 32 random
# bytes. Generate: openssl rand -base64 32
SESSION_SECRET=

# Only during a rotation: the previous SESSION_SECRET. Cookies signed with it
# stay valid while new ones use SESSION_SECRET. Remove it after 30 days.
# SESSION_SECRET_PREVIOUS=

# --- GitHub sign-in ---------------------------------------------------------

# Credentials of the GitHub app users sign in with. Create it at
# github.com > Settings > Developer settings > OAuth Apps with the callback URL
#   https://<your-domain>/api/auth/github/callback
# and a second app with http://localhost:3000/api/auth/github/callback for
# local work, so the production secret never sits on a laptop.
# No scopes are requested and no token is stored, so "Expire user access
# tokens" can stay enabled.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Database (Upstash Redis over REST) -------------------------------------

# Injected by the Upstash integration from the Vercel Marketplace. Without them
# local development uses a JSON file, and a Vercel deployment has no accounts.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# The names Upstash itself uses. Either pair works; these win if both are set.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Prefix for every Redis key. Default "gb:" in production and locally,
# "gb:<VERCEL_ENV>:" elsewhere, so preview deployments sharing the production
# database cannot touch production data.
# KEY_NAMESPACE=

# Local only: where the in-memory store persists itself.
# Default .data/store.json (git-ignored). Ignored on Vercel.
# GB_STORE_FILE=

# --- Pro --------------------------------------------------------------------

# "owner/name" of the repository whose stargazers are Pro.
# Default: the product's own repository (see src/lib/site.ts).
# PRO_REPO=

# Comma-separated GitHub logins that are always Pro, case-insensitive.
# Handy while the repository is still private.
# PRO_LOGINS=

# Server token of the GitHub data layer (src/lib/github/token.ts). Pro status
# is re-checked with it, so it must be able to list the stargazers of the Pro
# repository: a token of an owner or collaborator of that repository.
GITHUB_TOKEN=

# --- Local development only -------------------------------------------------

# Set to 1 in .env.development.local to enable GET /api/auth/dev, which signs
# you in as the account your GitHub CLI (`gh auth login`) is logged in as.
# The route does not exist in production builds. Never set this on Vercel.
# GITBANNERS_DEV_GH_LOGIN=1

# --- Tests only -------------------------------------------------------------

# Point the sign-in flow at a mock GitHub (tests/e2e/auth/mock-github.ts).
# Leave unset everywhere else: they default to github.com and api.github.com.
# GITHUB_WEB_URL=
# GITHUB_API_URL=

# --- Read by other parts of the app, relevant here --------------------------

# Canonical origin of the site (src/lib/site.ts). In production, sign-in always
# runs on this origin, and it must match the callback URL registered above.
# Default: the Vercel production domain.
# NEXT_PUBLIC_SITE_URL=
