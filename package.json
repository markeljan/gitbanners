    "@vercel/speed-insights": "^2.1.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "nuqs": "^2.10.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "swr": "^2.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.15",
    "@biomejs/biome": "2.4.2",
